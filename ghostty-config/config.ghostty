# ------------------------
# Window
# ------------------------

font-size = 14
window-padding-x = 8
window-padding-y = 8

# ------------------------
# Behavior
# ------------------------

copy-on-select = clipboard
gtk-titlebar = true
confirm-close-surface = false

# Disable shell integration while debugging.
shell-integration = none

# ------------------------
# Relay command
# ------------------------

command = /usr/local/bin/ghostty-shell