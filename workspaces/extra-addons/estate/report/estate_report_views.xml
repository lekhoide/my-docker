        <record id="estate_report_view_tree" model="ir.ui.view">
            <field name="name">estate.report.tree</field>
            <field name="model">estate.report</field>
            <field name="arch" type="xml">
                <list string="Properties Offers" decoration-success="offer_state == 'accepted'" decoration-muted="offer_state == 'refused'" decoration-bf="property_state == 'sold'">
                    <field name="property_id"/>
                    <field name="property_type_id"/>
                    <field name="property_state"/>
                    <field name="offer_state"/>
                </list>
            </field>
        </record>

        <record id="estate_report_view_form" model="ir.ui.view">
            <field name="name">estate.report.form</field>
            <field name="model">estate.report</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="property_id"/>
                            <field name="property_type_id"/>
                            <field name="property_state"/>
                            <field name="offer_state"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="estate_report_view_list_form_action" model="ir.actions.act_window">
            <field name="name">Estate Report List Form Action</field>
            <field name="res_model">estate.report</field>
            <field name="view_mode">list,form</field>
        </record>

        <record model="ir.actions.act_window" id="estate_report_graph_action">
            <field name="name">Estate Report Graph</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="estate.estate_property_graph_view"/>
        </record>

        <record id="estate_report_view_dashboard" model="ir.ui.view">
            <field name="name">Estate Report Dashboard Form</field>
            <field name="model">board.board</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Estate Report Dashboard">
                    <board style="2-1">
                        <column>
                            <action
                                    string="Bedrooms"
                                    name="%(estate_report_graph_action)d"
                                    height="150"
                                    width="510"/>
                        </column>
                        <column>
                            <action string="Property" name="%(estate_report_view_list_form_action)d"/>
                        </column>
                    </board>
                </form>
            </field>
        </record>

        <record id="estate_report_dashboard_action" model="ir.actions.act_window">
            <field name="name">Offer Analysis</field>
            <field name="res_model">board.board</field>
            <field name="view_mode">form</field>
            <field name="usage">menu</field>
            <field name="view_id" ref="estate_report_view_dashboard"/>
        </record>

        <menuitem
            id="estate_dashboard_menuitem"
            name="Offer Analysis"
            parent="spreadsheet_dashboard.spreadsheet_dashboard_menu_root"
            action="estate_report_dashboard_action"/>
    </data>
</odoo>