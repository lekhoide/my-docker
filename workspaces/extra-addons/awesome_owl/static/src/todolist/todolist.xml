<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todoitem">
        <!-- Item 1: Đang làm -->
        <div class="list-group-item d-flex align-items-center py-3 border-bottom shadow-sm-hover">
            <span class="me-3 fw-bold text-muted"><t t-esc="props.index"/></span>
            <div class="form-check flex-grow-1">
                <input class="form-check-input me-2" type="checkbox" t-att-id="item.id" t-on-click.stop="toggleState"/>
                <label class="form-check-label fs-5" t-att-class="{'text-decoration-line-through text-muted': item.isCompleted}" t-att-for="item.id">
                    <t t-esc="item.description"/>
                </label>
            </div>
            <button class="btn btn-outline-danger btn-sm border-0 rounded-circle" t-on-click="toggleRemove">
                <i class="fa fa-trash"></i>
            </button>
            <!-- <t t-set="foo" t-value="42"/>
