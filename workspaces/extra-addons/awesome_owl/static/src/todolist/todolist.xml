    <t t-name="awesome_owl.todolist">
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-lg border-0 rounded-3">
                        <!-- Header -->
                        <div class="card-header bg-primary text-white py-3">
                            <h3 class="mb-0 text-center">
                                <i class="fa fa-list-check me-2"></i>My Todo List
                            </h3>
                        </div>

                        <div class="card-body p-4">
                            <!-- Input Section -->
                            <div class="input-group mb-4">
                                <input 
                                    type="text" 
                                    class="form-control form-control-lg border-primary-subtle" 
                                    placeholder="Add a new task..." 
                                    aria-label="New task"
                                    t-ref="todo-input"
                                />
                                <button class="btn btn-primary px-4" type="button" t-on-click.prevent="addTodo">
                                    <i class="fa fa-plus-circle me-1"></i>Add
                                </button>
                            </div>

                            <!-- Todo List -->
                            <div class="list-group list-group-flush">
                                <t t-foreach="this.todos" t-as="item" t-key="item.id">
                                    <Todoitem index="item_index + 1"
                                        id="item.id"
                                        description="item.description"
                                        isCompleted="item.isCompleted"
                                        onChange="(val) => this.removeTodo(val)"
                                        onToggle="(val) => this.toggleState(val)"
                                        />
                                </t>
                            </div>
                        </div>

                        <!-- Footer Info -->
                        <div class="card-footer bg-white text-center py-2 border-0">
                            <small class="text-muted">You have <t t-esc="countPendingTasks"/> pending tasks</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
